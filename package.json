{
  "name": "dbms-project",
  "version": "1.0.0",
  "description": "Enterprise Vehicle Rental Database Management System",
  "main": "server/src/server.js",
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node --watch server/src/server.js",
    "dev:client": "npm --prefix client run dev",
    "start": "node server/src/server.js",
    "server": "node server/src/server.js",
    "client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "test": "node --test server/tests/api.test.js",
    "migrate": "node server/src/db/migrate.js",
    "seed": "node server/src/db/seed.js"
  },
  "keywords": [
    "dbms",
    "vehicle-rental",
    "sqlite",
    "express",
    "react"
  ],
  "author": "Antigravity Engineering",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
